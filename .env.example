# Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Used for auth redirects and metadata on Vercel
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional server-only preview override. Never enable on a public deployment.
# Local `npm run dev` already supports browser-demo editing without this flag.
# STUDIO_DEMO_MODE=true

# Google OAuth (server-only) for contact delivery and Calendar/Meet booking
# The refresh token must be authorized for Rashi's Google account with
# https://www.googleapis.com/auth/calendar.events
# https://www.googleapis.com/auth/calendar.events.freebusy
# https://www.googleapis.com/auth/gmail.send
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REFRESH_TOKEN=your-long-lived-refresh-token
GOOGLE_CALENDAR_ID=primary
RASHI_CONTACT_EMAIL=rashichugh610@gmail.com

# Optional booking rules (defaults shown)
BOOKING_TIME_ZONE=Asia/Calcutta
BOOKING_DURATION_MINUTES=30
BOOKING_START_HOUR=10
BOOKING_END_HOUR=18
BOOKING_MAX_DAYS=60
BOOKING_MIN_NOTICE_HOURS=2
